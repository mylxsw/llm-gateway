# A narrow backend patch layered on the currently deployed immutable image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision=${SOURCE_SHA}
COPY --chown=appuser:appuser backend/app/api/deps.py /app/backend/app/api/deps.py
COPY --chown=appuser:appuser backend/app/config.py /app/backend/app/config.py
COPY --chown=appuser:appuser backend/app/db/redis.py /app/backend/app/db/redis.py
COPY --chown=appuser:appuser backend/app/main.py /app/backend/app/main.py
COPY --chown=appuser:appuser backend/app/services/active_requests.py /app/backend/app/services/active_requests.py
COPY --chown=appuser:appuser backend/app/services/redis_runtime.py /app/backend/app/services/redis_runtime.py
COPY --chown=appuser:appuser backend/app/repositories/sqlalchemy/provider_repo.py /app/backend/app/repositories/sqlalchemy/provider_repo.py
